@{
}
@model EmpleadoVM

<h1>Nuevo empleado</h1>

<form asp-controller="Empleado" asp-action="Nuevo" method="post">
    <div class="row">
        <div class="col-sm-8 offset-sm-2">
            <h2>Nuevo</h2>

            <div class="mb-3">
                <label asp-for="Nombre"></label>
                <input class="form-control" asp-for="Nombre" type="text" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="correo"></label>
                <input class="form-control" asp-for="correo" type="email" />
                <span asp-validation-for="correo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Clave"></label>
                <input class="form-control" asp-for="Clave" type="password" />
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaContrato"></label>
                <input class="form-control" asp-for="FechaContrato" type="date" />
            </div>

            <div class="mb-3 form-check">
                <input class="form-check-input" asp-for="Activo" type="checkbox" id="chkActivo" />
                <label class="form-check-label" for="chkActivo">Activo</label>
            </div>

            <div class="mb-3">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <a asp-controller="Empleado" asp-action="Lista" class="btn btn-warning">Volver</a>
            </div>

        </div>
    </div>
</form>